DASHSCOPE_API_KEY=replace-with-your-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.7-plus
DASHSCOPE_GUARD_MODEL=ZHIPU/GLM-5.3-Flash
# AGENT_MAX_TOKENS=4096
# AGENT_CONTEXT_WINDOW_TOKENS=131072
# AGENT_AUTO_COMPACT_TOKEN_LIMIT=117964
# AGENT_MCP_CONFIG=/absolute/path/to/.mcp.json
AGENT_TRACE=compact
AGENT_TRACE_MAX_RESULT_CHARS=800
AGENT_LOOP_GUARD_THRESHOLDS=3,5,8
AGENT_NO_PROGRESS_THRESHOLDS=12,24
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=ai_agent
